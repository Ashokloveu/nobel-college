# Node Environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/nobel_college_db

# Authentication Secrets
JWT_SECRET=nobel_college_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=nobel_college_super_secret_refresh_key_2026_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=nobel_college_cookie_secret_key_2026

# SMTP / Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_user
SMTP_PASSWORD=placeholder_password
EMAIL_FROM="Nobel Multiple College <info@nobelcollege.edu.np>"

# File Storage Configuration
STORAGE_TYPE=local # local | s3
STORAGE_ENDPOINT=http://localhost:5000/uploads
UPLOAD_DIR=./uploads

# Admin Initial Seed Credentials
SEED_ADMIN_EMAIL=admin@nobelcollege.edu.np
SEED_ADMIN_PASSWORD=Admin@Nobel2026!
